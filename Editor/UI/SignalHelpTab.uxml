<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd">
    <ui:ScrollView class="tab-scroll-view">
        <ui:VisualElement class="signal-card">
            
            <ui:Label text="SIGNAL QUICK START" class="section-header" style="font-size: 15px; margin-bottom: 16px;" />

            <!-- Section 1: Setup & Initialization -->
            <ui:Foldout text="1. Getting Started &amp; Initialization" class="audio-entry-foldout" value="true">
                <ui:Label text="Signal is a zero-setup audio engine. You do not need to drag prefabs into your scene." class="help-text" />
                <ui:Label text="Calling Signal.PlaySFX() or Signal.PlayMusic() automatically initializes the audio host when missing." class="help-text" />
            </ui:Foldout>

            <!-- Section 2: Playing Audio (SFX & UI) -->
            <ui:Foldout text="2. Playing Sound Effects (2D &amp; 3D)" class="audio-entry-foldout" value="false">
                <ui:Label text="Standard 2D sound effect:" class="help-text" />
                <ui:VisualElement class="code-box">
                    <ui:Label text='Signal.PlaySFX("explosion");' class="code-text" />
                </ui:VisualElement>

                <ui:Label text="3D sound at world position:" class="help-text" />
                <ui:VisualElement class="code-box">
                    <ui:Label text='Signal.PlaySFX("impact", transform.position);' class="code-text" />
                </ui:VisualElement>

                <ui:Label text="3D sound following a moving transform:" class="help-text" />
                <ui:VisualElement class="code-box">
                    <ui:Label text='Signal.PlaySFX("engine_loop", transform);' class="code-text" />
                </ui:VisualElement>

                <ui:Label text="UI sound (unpaused, 2D):" class="help-text" />
                <ui:VisualElement class="code-box">
                    <ui:Label text='Signal.PlayUI("click");' class="code-text" />
                </ui:VisualElement>
            </ui:Foldout>

            <!-- Section 3: Music & Crossfades -->
            <ui:Foldout text="3. Music &amp; Crossfades" class="audio-entry-foldout" value="false">
                <ui:Label text="Crossfade to track with 2s transition:" class="help-text" />
                <ui:VisualElement class="code-box">
                    <ui:Label text='Signal.PlayMusic("boss_theme", 2.0f);' class="code-text" />
                </ui:VisualElement>

                <ui:Label text="Fade out and stop music:" class="help-text" />
                <ui:VisualElement class="code-box">
                    <ui:Label text='Signal.StopMusic(1.5f);' class="code-text" />
                </ui:VisualElement>
            </ui:Foldout>

            <!-- Section 4: Global Controls -->
            <ui:Foldout text="4. Global Mixer Volumes" class="audio-entry-foldout" value="false">
                <ui:Label text="Mixer volume controls (0.0 to 1.0):" class="help-text" />
                <ui:VisualElement class="code-box">
                    <ui:Label text='Signal.SetMasterVolume(1.0f);' class="code-text" />
                    <ui:Label text='Signal.SetMusicVolume(0.8f);' class="code-text" />
                    <ui:Label text='Signal.SetSFXVolume(0.9f);' class="code-text" />
                    <ui:Label text='Signal.SetUIVolume(1.0f);' class="code-text" />
                </ui:VisualElement>
            </ui:Foldout>

            <!-- API Cheat Sheet -->
            <ui:Label text="API REFERENCE" class="section-header" style="margin-top: 20px;" />
            <ui:VisualElement class="table-container">
                <ui:VisualElement class="table-header-row">
                    <ui:Label text="Method" class="table-header-cell" style="width: 50%;" />
                    <ui:Label text="Description" class="table-header-cell" style="width: 50%;" />
                </ui:VisualElement>
                
                <ui:VisualElement class="table-row">
                    <ui:Label text="Signal.PlaySFX(id)" class="table-cell-code" style="width: 50%;" />
                    <ui:Label text="Plays a 2D sound effect." class="table-cell-desc" style="width: 50%;" />
                </ui:VisualElement>
                <ui:VisualElement class="table-row table-row-alt">
                    <ui:Label text="Signal.PlaySFX(id, position)" class="table-cell-code" style="width: 50%;" />
                    <ui:Label text="Plays a 3D sound at a world position." class="table-cell-desc" style="width: 50%;" />
                </ui:VisualElement>
                <ui:VisualElement class="table-row">
                    <ui:Label text="Signal.PlaySFX(id, transform)" class="table-cell-code" style="width: 50%;" />
                    <ui:Label text="Plays a 3D sound tracking a transform." class="table-cell-desc" style="width: 50%;" />
                </ui:VisualElement>
                <ui:VisualElement class="table-row table-row-alt">
                    <ui:Label text="Signal.PlayDelayedSFX(id, delay)" class="table-cell-code" style="width: 50%;" />
                    <ui:Label text="Plays sound effect after delay in seconds." class="table-cell-desc" style="width: 50%;" />
                </ui:VisualElement>
                <ui:VisualElement class="table-row">
                    <ui:Label text="Signal.PlayUI(id)" class="table-cell-code" style="width: 50%;" />
                    <ui:Label text="Plays a 2D UI sound ignoring game pause." class="table-cell-desc" style="width: 50%;" />
                </ui:VisualElement>
                <ui:VisualElement class="table-row table-row-alt">
                    <ui:Label text="Signal.PlayMusic(id, fade)" class="table-cell-code" style="width: 50%;" />
                    <ui:Label text="Smoothly crossfades to background music." class="table-cell-desc" style="width: 50%;" />
                </ui:VisualElement>
                <ui:VisualElement class="table-row">
                    <ui:Label text="Signal.StopMusic(fade)" class="table-cell-code" style="width: 50%;" />
                    <ui:Label text="Fades out and stops active music." class="table-cell-desc" style="width: 50%;" />
                </ui:VisualElement>
                <ui:VisualElement class="table-row table-row-alt">
                    <ui:Label text="Signal.PauseMusic() / ResumeMusic()" class="table-cell-code" style="width: 50%;" />
                    <ui:Label text="Pauses or resumes music track." class="table-cell-desc" style="width: 50%;" />
                </ui:VisualElement>
                <ui:VisualElement class="table-row">
                    <ui:Label text="Signal.StopInstance(instanceId)" class="table-cell-code" style="width: 50%;" />
                    <ui:Label text="Stops sound instance identified by ID." class="table-cell-desc" style="width: 50%;" />
                </ui:VisualElement>
                <ui:VisualElement class="table-row table-row-alt">
                    <ui:Label text="Signal.SetMasterVolume(vol)" class="table-cell-code" style="width: 50%;" />
                    <ui:Label text="Sets normalized Master volume (0.0 to 1.0)." class="table-cell-desc" style="width: 50%;" />
                </ui:VisualElement>
                <ui:VisualElement class="table-row">
                    <ui:Label text="Signal.SetMusicVolume(vol)" class="table-cell-code" style="width: 50%;" />
                    <ui:Label text="Sets normalized Music volume (0.0 to 1.0)." class="table-cell-desc" style="width: 50%;" />
                </ui:VisualElement>
                <ui:VisualElement class="table-row table-row-alt">
                    <ui:Label text="Signal.SetSFXVolume(vol)" class="table-cell-code" style="width: 50%;" />
                    <ui:Label text="Sets normalized SFX volume (0.0 to 1.0)." class="table-cell-desc" style="width: 50%;" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>