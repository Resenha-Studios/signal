<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    
    <!-- Top Header Bar (Guardian Standard) -->
    <ui:VisualElement name="signal-header" class="signal-header">
        <ui:VisualElement class="signal-brand">
            <ui:VisualElement style="flex-direction: row; align-items: center;">
                <ui:Label text="Signal" name="header-title" class="signal-title" />
                <ui:Label text="v2.0" class="signal-version-badge" />
            </ui:VisualElement>
            <ui:Label text="Audio Architecture &amp; Sound Manager" name="header-subtitle" class="signal-subtitle" />
        </ui:VisualElement>
        
        <ui:VisualElement class="signal-header-actions">
            <ui:DropdownField name="language-dropdown" class="signal-lang-dropdown" tooltip="Change dashboard language" />
            <ui:Button name="btn-header-setup" text="+ Setup" class="signal-btn-secondary" tooltip="Run or recreate initial audio setup" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Welcome / Setup Screen (shown when config is missing) -->
    <ui:VisualElement name="welcome-screen" class="welcome-screen">
        <ui:VisualElement class="welcome-card">
            <ui:VisualElement class="welcome-icon-box">
                <ui:Label text="♪" class="welcome-glyph" />
            </ui:VisualElement>
            <ui:Label text="Signal Audio Architecture" name="welcome-title" class="welcome-title" />
            <ui:Label text="No audio configuration found in this project." name="welcome-subtitle" class="welcome-subtitle" />
            <ui:Label text="Click below to initialize folders, audio mixers, prefabs, and configuration assets automatically." name="welcome-desc" class="welcome-desc" />
            <ui:Button name="btn-initial-setup" text="Initialize Signal" class="signal-btn-primary" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Main Dashboard Container -->
    <ui:VisualElement name="dashboard-container" class="dashboard-container">
        <!-- Sidebar Navigation -->
        <ui:VisualElement name="sidebar" class="sidebar">
            <ui:Button name="tab-global" class="sidebar-btn sidebar-btn-active">
                <ui:VisualElement name="icon-global" class="sidebar-icon" />
                <ui:Label text="Settings" name="lbl-tab-global" />
            </ui:Button>
            
            <ui:Button name="tab-music" class="sidebar-btn">
                <ui:VisualElement name="icon-music" class="sidebar-icon" />
                <ui:Label text="Music" name="lbl-tab-music" />
            </ui:Button>
            
            <ui:Button name="tab-sfx" class="sidebar-btn">
                <ui:VisualElement name="icon-sfx" class="sidebar-icon" />
                <ui:Label text="SFX &amp; UI" name="lbl-tab-sfx" />
            </ui:Button>
            
            <ui:Button name="tab-tools" class="sidebar-btn">
                <ui:VisualElement name="icon-tools" class="sidebar-icon" />
                <ui:Label text="Import Tools" name="lbl-tab-tools" />
            </ui:Button>

            <ui:VisualElement style="flex-grow: 1;" />

            <ui:Button name="tab-help" class="sidebar-btn sidebar-btn-help">
                <ui:VisualElement name="icon-help" class="sidebar-icon" />
                <ui:Label text="Docs" name="lbl-tab-help" />
            </ui:Button>
        </ui:VisualElement>

        <!-- Dynamic Content Area -->
        <ui:VisualElement name="main-content" class="main-content">
            <ui:Label text="Loading..." class="signal-loading-text" />
        </ui:VisualElement>
    </ui:VisualElement>

</ui:UXML>