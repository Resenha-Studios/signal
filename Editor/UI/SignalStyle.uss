/* ==============================================================================
 * SIGNAL AUDIO ARCHITECTURE — STYLE SHEET (UI Toolkit)
 * Clean & Minimal AAA Design System (Guardian Standard)
 * ==============================================================================*/

/* Root Container */
.dashboard-container {
    flex-grow: 1;
    flex-direction: row;
    background-color: #0b0f14;
    color: #e2e8f0;
}

/* Header Bar */
.signal-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: #0d1219;
    border-bottom-width: 1px;
    border-bottom-color: #242f3d;
}

.signal-brand {
    flex-direction: column;
}

.signal-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #f8fafc;
    letter-spacing: 0.5px;
}

.signal-version-badge {
    font-size: 10px;
    -unity-font-style: bold;
    color: #38bdf8;
    background-color: rgba(56, 189, 248, 0.12);
    border-radius: 4px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-left: 8px;
}

.signal-subtitle {
    font-size: 11px;
    color: #94a3b8;
    margin-top: 2px;
}

.signal-header-actions {
    flex-direction: row;
    align-items: center;
}

.signal-lang-dropdown {
    width: 110px;
    margin-right: 10px;
}

/* Buttons */
.signal-btn-primary {
    background-color: #0284c7;
    color: #ffffff;
    font-size: 12px;
    -unity-font-style: bold;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 7px;
    padding-bottom: 7px;
    border-radius: 6px;
    border-width: 0;
    cursor: link;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.signal-btn-primary:hover {
    background-color: #0ea5e9;
}

.signal-btn-primary:active {
    background-color: #0369a1;
}

.signal-btn-secondary {
    background-color: #1e2632;
    color: #e2e8f0;
    font-size: 12px;
    -unity-font-style: bold;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #354456;
    cursor: link;
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
}

.signal-btn-secondary:hover {
    background-color: #273140;
    border-color: #38bdf8;
    color: #ffffff;
}

.signal-btn-secondary:active {
    background-color: #141a22;
}

/* Sidebar */
.sidebar {
    width: 180px;
    min-width: 150px;
    max-width: 210px;
    background-color: #0e131b;
    border-right-width: 1px;
    border-right-color: #1e293b;
    padding: 12px 8px;
}

.sidebar-btn {
    height: 36px;
    -unity-text-align: middle-left;
    padding-left: 10px;
    margin-bottom: 4px;
    border-radius: 6px;
    background-color: transparent;
    border-width: 0;
    font-size: 12px;
    color: #94a3b8;
    flex-direction: row;
    align-items: center;
    cursor: link;
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.sidebar-btn:hover {
    background-color: rgba(56, 189, 248, 0.08);
    color: #f1f5f9;
}

.sidebar-btn-active {
    background-color: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    -unity-font-style: bold;
}

.sidebar-btn-active:hover {
    background-color: rgba(56, 189, 248, 0.2);
    color: #38bdf8;
}

.sidebar-icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    opacity: 0.85;
}

/* Main Content Area */
.main-content {
    flex-grow: 1;
    padding: 16px;
    overflow: hidden;
    background-color: #0b0f14;
}

.tab-scroll-view {
    flex-grow: 1;
}

/* Cards & Containers */
.signal-card, .section-container {
    background-color: #111822;
    border-radius: 8px;
    border-width: 1px;
    border-color: #242f3d;
    padding: 16px;
    margin-bottom: 12px;
}

.card-accent {
    border-left-width: 3px;
    border-left-color: #38bdf8;
}

.section-header {
    font-size: 11px;
    -unity-font-style: bold;
    color: #38bdf8;
    letter-spacing: 1.5px;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(56, 189, 248, 0.15);
    padding-bottom: 6px;
}

.accent-header {
    color: #38bdf8;
}

.help-text {
    font-size: 12px;
    color: #94a3b8;
    white-space: normal;
    margin-bottom: 8px;
}

.code-snippet-hint {
    font-size: 11px;
    color: #38bdf8;
    background-color: #0b0f14;
    border-radius: 4px;
    padding: 6px 10px;
    margin-top: 4px;
}

/* Welcome Screen */
.welcome-screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: #0b0f14;
}

.welcome-card {
    width: 80%;
    max-width: 520px;
    align-items: center;
    padding: 36px 28px;
    background-color: #111822;
    border-radius: 10px;
    border-width: 1px;
    border-color: #242f3d;
}

.welcome-icon-box {
    width: 54px;
    height: 54px;
    border-radius: 27px;
    background-color: rgba(56, 189, 248, 0.12);
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
}

.welcome-glyph {
    font-size: 26px;
    color: #38bdf8;
}

.welcome-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: #f8fafc;
    margin-bottom: 6px;
}

.welcome-subtitle {
    font-size: 12px;
    color: #94a3b8;
    margin-bottom: 16px;
}

.welcome-desc {
    font-size: 12px;
    color: #64748b;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

/* Audio Library & Entry Items */
.library-container {
    flex-grow: 1;
}

.library-toolbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.library-search {
    flex-grow: 1;
    max-width: 320px;
    border-radius: 6px;
    background-color: #111822;
    border-color: #242f3d;
}

.library-toolbar-actions {
    flex-direction: row;
}

.toolbar-action-btn {
    font-size: 11px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-radius: 5px;
    margin-left: 6px;
    background-color: #16202c;
    border-width: 1px;
    border-color: #2a3749;
    color: #cbd5e1;
    cursor: link;
}

.toolbar-action-btn:hover {
    background-color: #223042;
    color: #ffffff;
}

.delete-all-btn {
    border-color: rgba(239, 68, 68, 0.4);
    color: #f87171;
}

.delete-all-btn:hover {
    background-color: rgba(239, 68, 68, 0.2);
    color: #fca5a5;
}

.audio-list-view {
    flex-grow: 1;
    min-height: 250px;
}

.audio-entry-card {
    background-color: #111822;
    border-radius: 6px;
    border-width: 1px;
    border-color: #1f2937;
    margin-bottom: 8px;
    padding: 10px;
}

.audio-entry-header {
    flex-direction: row;
    align-items: center;
}

.audio-id-field {
    flex-grow: 1;
    margin-right: 8px;
}

.audio-id-field .unity-base-text-field__input {
    background-color: #0b0f14;
    border-radius: 4px;
    border-color: #263342;
    color: #f1f5f9;
}

.icon-btn {
    width: 28px;
    height: 26px;
    border-radius: 4px;
    border-width: 1px;
    margin-left: 4px;
    cursor: link;
    -unity-text-align: middle-center;
    font-size: 11px;
}

.play-btn {
    background-color: #065f46;
    border-color: #10b981;
    color: #34d399;
}

.play-btn:hover {
    background-color: #047857;
}

.stop-btn {
    background-color: #1e2632;
    border-color: #354456;
    color: #94a3b8;
}

.stop-btn:hover {
    background-color: #273140;
    color: #f1f5f9;
}

.delete-btn {
    background-color: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.3);
    color: #f87171;
}

.delete-btn:hover {
    background-color: rgba(239, 68, 68, 0.25);
    color: #ffffff;
}

.audio-entry-foldout {
    margin-top: 8px;
    border-top-width: 1px;
    border-top-color: #1a232f;
    padding-top: 8px;
}

.sliders-container {
    margin-top: 6px;
}

/* Pagination Footer */
.pagination-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 10px;
    margin-top: 6px;
    border-top-width: 1px;
    border-top-color: #1e293b;
}

.pagination-footer-left, .pagination-footer-right {
    flex-direction: row;
    align-items: center;
}

.pagination-btn {
    width: 28px;
    height: 26px;
    border-radius: 4px;
    background-color: #16202c;
    border-width: 1px;
    border-color: #2a3749;
    color: #cbd5e1;
    cursor: link;
    -unity-text-align: middle-center;
}

.pagination-btn:hover {
    background-color: #223042;
    color: #ffffff;
}

.pagination-label {
    font-size: 11px;
    color: #94a3b8;
    margin-left: 10px;
    margin-right: 10px;
}

/* Documentation / Help Tab Styles */
.code-box {
    background-color: #0b0f14;
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: #38bdf8;
    padding: 8px 12px;
    margin-bottom: 12px;
}

.code-text {
    font-size: 11px;
    color: #38bdf8;
    -unity-font-style: bold;
}

.table-container {
    border-radius: 6px;
    border-width: 1px;
    border-color: #242f3d;
    overflow: hidden;
    margin-bottom: 24px;
}

.table-header-row {
    flex-direction: row;
    background-color: #16202c;
    padding: 8px 12px;
    border-bottom-width: 1px;
    border-bottom-color: #242f3d;
}

.table-header-cell {
    font-size: 10px;
    -unity-font-style: bold;
    color: #38bdf8;
    letter-spacing: 1px;
}

.table-row {
    flex-direction: row;
    background-color: #0e141c;
    padding: 8px 12px;
    border-bottom-width: 1px;
    border-bottom-color: #18222f;
}

.table-row-alt {
    background-color: #111822;
}

.table-cell-code {
    font-size: 11px;
    color: #7dd3fc;
    -unity-font-style: italic;
}

.table-cell-desc {
    font-size: 11px;
    color: #94a3b8;
    white-space: normal;
}

/* Responsiveness */
.collapsed-mode .sidebar {
    width: 52px;
    min-width: 52px;
    padding: 8px 4px;
}

.collapsed-mode .sidebar-btn Label {
    display: none;
}

.collapsed-mode .sidebar-icon {
    margin-right: 0;
}
