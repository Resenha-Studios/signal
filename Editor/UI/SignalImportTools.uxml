<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    
    <ui:ScrollView class="tab-scroll-view">

        <!-- Importer Rules hint card -->
        <ui:VisualElement class="signal-card card-accent">
            <ui:Label text="IMPORTER AUTOMATION" name="lbl-rules-title" class="section-header accent-header" />
            <ui:Label text="Drop your audio folders to automatically generate entries. The file prefix is stripped to create clean IDs." name="lbl-rules-desc" class="help-text" />
        </ui:VisualElement>

        <!-- Music Importer -->
        <ui:VisualElement class="signal-card">
            <ui:Label text="MUSIC IMPORTER" name="lbl-music-importer" class="section-header" />
            
            <uie:ObjectField name="folder-picker-music" label="Source Folder" tooltip="Select directory containing background music audio files" />
            <ui:TextField name="prefix-input-music" label="File Prefix" tooltip="Prefix filtered and stripped from IDs (e.g. 'mus_')" />
            
            <ui:VisualElement style="align-items: flex-end; margin-top: 12px;">
                <ui:Button name="btn-run-import-music" text="Import Music" class="signal-btn-primary" tooltip="Parse music files into music library" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- SFX & UI Importer -->
        <ui:VisualElement class="signal-card">
            <ui:Label text="SFX IMPORTER" name="lbl-sfx-importer" class="section-header" />
            
            <uie:ObjectField name="folder-picker-sfx" label="Source Folder" tooltip="Select directory containing sound effect audio files" />
            <ui:TextField name="prefix-input-sfx" label="File Prefix" tooltip="Prefix filtered and stripped from IDs (e.g. 'sfx_')" />
            
            <ui:VisualElement style="align-items: flex-end; margin-top: 12px;">
                <ui:Button name="btn-run-import-sfx" text="Import SFX" class="signal-btn-primary" tooltip="Parse sound effects into SFX library" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Batch Renamer -->
        <ui:VisualElement class="signal-card">
            <ui:Label text="BATCH RENAMER" name="lbl-batch-renamer" class="section-header" />
            
            <uie:ObjectField name="folder-picker-rename" label="Target Folder" tooltip="Folder containing audio files to prepend prefix to" />
            <ui:TextField name="prefix-input-rename" label="Prefix to Add" tooltip="Prefix to prepend to all audio files in the folder" />
            
            <ui:VisualElement style="align-items: flex-end; margin-top: 12px;">
                <ui:Button name="btn-run-rename" text="Batch Rename" class="signal-btn-secondary" tooltip="Prepend prefix to filenames in folder" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:ScrollView>
</ui:UXML>