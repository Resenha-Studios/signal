<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd"
>
    <ui:ScrollView class="tab-scroll-view">

        <!-- Audio Mixer Configuration -->
        <ui:VisualElement class="signal-card">
            <ui:Label text="AUDIO MIXER" name="lbl-mixer-section" class="section-header" />
            <uie:PropertyField binding-path="audioMixer" label="Main Audio Mixer" tooltip="Target Audio Mixer asset with exposed volume parameters" />
            <uie:PropertyField binding-path="masterVolumeParam" label="Master Volume Param" tooltip="Exposed parameter name for master volume" />
            <uie:PropertyField binding-path="musicVolumeParam" label="Music Volume Param" tooltip="Exposed parameter name for background music" />
            <uie:PropertyField binding-path="sfxVolumeParam" label="SFX Volume Param" tooltip="Exposed parameter name for sound effects" />
            <uie:PropertyField binding-path="uiVolumeParam" label="UI Volume Param" tooltip="Exposed parameter name for UI audio" />
        </ui:VisualElement>

        <!-- Asset References -->
        <ui:VisualElement class="signal-card">
            <ui:Label text="ASSET REFERENCES" name="lbl-assets-section" class="section-header" />
            <uie:PropertyField binding-path="sfxPrefab" label="SFX AudioSource Prefab" tooltip="Prefab with AudioSource and PooledAudioSource component" />
        </ui:VisualElement>

        <!-- General Settings -->
        <ui:VisualElement class="signal-card">
            <ui:Label text="GENERAL SETTINGS" name="lbl-general-section" class="section-header" />
            <uie:PropertyField binding-path="maxSimultaneousMusic" label="Max Simultaneous Music" tooltip="Limit of active music tracks transitioning concurrently" />
            <uie:PropertyField binding-path="sfxPoolSize" label="SFX Pool Size" tooltip="Pre-allocated audio source instances in object pool" />
        </ui:VisualElement>

        <!-- Code Generation -->
        <ui:VisualElement class="signal-card card-accent">
            <ui:Label text="AUDIO KEYS GENERATION" name="lbl-codegen-section" class="section-header accent-header" />
            <ui:Label text="Generate strongly-typed C# constants for Audio IDs to avoid typos and unlock IDE autocomplete." name="lbl-codegen-desc" class="help-text" />
            <ui:Label text="Usage: Signal.PlaySFX(AudioKeys.SFX.jump);" name="lbl-codegen-example" class="code-snippet-hint" />

            <ui:VisualElement style="flex-direction: row; margin-top: 10px; align-items: center;">
                <ui:TextField name="keys-path-field" is-read-only="true" style="flex-grow: 1; margin-right: 8px;" tooltip="Script destination path" />
                <ui:Button name="btn-change-keys-path" text="Browse" class="signal-btn-secondary" tooltip="Select file location for AudioKeys.cs" />
            </ui:VisualElement>

            <ui:VisualElement style="align-items: flex-end; margin-top: 12px;">
                <ui:Button name="btn-generate-keys" text="Generate AudioKeys" class="signal-btn-primary" tooltip="Create or regenerate AudioKeys.cs" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:ScrollView>
</ui:UXML>